# Backend origin only, without trailing slash and without /api/v1
NEXT_PUBLIC_API_URL=
# Optional, server only: backend origin for the ISR of /impact (falls back to NEXT_PUBLIC_API_URL)
API_URL_INTERNAL=
# Optional, server only: full URLs (comma separated) that GET /api/wake pings to wake Render,
# e.g. <backend>/health, <backend>/api/v1/health/ready (also wakes Neon) and <ai>/health
WAKE_URLS=
# Optional, PUBLIC on purpose: the demo accounts shown on the login page (never the real ones).
# Without them the "evaluate the project" card is hidden.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_OPERATOR_EMAIL=
NEXT_PUBLIC_DEMO_OPERATOR_PASSWORD=
